# Runtime mode. Any value other than Development selects managed-identity providers.
AZURE_FUNCTIONS_ENVIRONMENT=Development
NODE_ENV=development
PORT=7071
APP_BASE_URL=http://localhost:7071

# Application auth. Replace locally; never use this placeholder in production.
AUTH_JWT_SECRET=replace-me-with-a-local-dev-secret
AUTH_JWT_ISSUER=oksbi-api
AUTH_JWT_AUDIENCE=oksbi-app

# Local PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oksbi

# Managed-identity PostgreSQL.
POSTGRES_HOST=oksbi-postgres.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=oksbi
POSTGRES_USER=oksbi_app
POSTGRES_SSL_MODE=require

# Local Blob Storage.
AZURITE_CONNECTION_STRING=UseDevelopmentStorage=true

# Managed-identity Blob Storage.
AZURE_STORAGE_ACCOUNT=oksbistorage

# Local Redis.
REDIS_URL=redis://localhost:6379

# Managed-identity Redis.
REDIS_HOST=oksbi-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_TLS=true
REDIS_AAD_SCOPE=https://redis.azure.com/.default
REDIS_USER=oksbi-app